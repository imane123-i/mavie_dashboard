<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mv_batch_shop_mapping_tree_ext" model="ir.ui.view">
        <field name="name">mv.batch.shop.mapping.tree.ext.mavie</field>
        <field name="model">mv.batch.shop.mapping</field>
        <field name="inherit_id" ref="mv_base_pivot.view_mv_batch_shop_mapping_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="city"/>
                <field name="responsible_user_id"/>
            </field>
        </field>
    </record>

    <record id="view_mv_batch_shop_mapping_form_ext" model="ir.ui.view">
        <field name="name">mv.batch.shop.mapping.form.ext.mavie</field>
        <field name="model">mv.batch.shop.mapping</field>
        <field name="inherit_id" ref="mv_base_pivot.view_mv_batch_shop_mapping_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Responsable &amp; Localisation">
                    <field name="city"/>
                    <field name="responsible_user_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
